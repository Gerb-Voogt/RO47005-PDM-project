% Linearizes the model with a few assumptions and generates continuous and
% discrete state space A,B matrices

veh_parameters;
vx = V_ref;

A = [0, 1, 0, 0;
    0, -(par.Calpha_front+par.Calpha_rear)/(par.mass*vx), (par.Calpha_front+par.Calpha_rear)/(par.mass), (-par.Calpha_front*par.l_f+par.Calpha_rear*par.l_r)/(par.mass*vx);
    0, 0, 0, 1;
    0, (-par.Calpha_front*par.l_f+par.Calpha_rear*par.l_r)/(par.Izz*vx), (par.Calpha_front*par.l_f-par.Calpha_rear*par.l_r)/(par.Izz), -(par.Calpha_front*par.l_f^2+par.Calpha_rear*par.l_r^2)/(par.Izz*vx)];

B1 = [0; par.Calpha_front/par.mass; 0; par.Calpha_front*par.l_f/par.Izz];

B2 = [0; (-par.Calpha_front*par.l_f+par.Calpha_rear*par.l_r)/(par.mass*vx)-vx; 0; -(par.Calpha_front*par.l_f^2+par.Calpha_rear*par.l_r^2)/(par.Izz*vx)];

B = [B1, B2];

sysc = ss(A,B,eye(size(A,1)),[]);
sysd = c2d(sysc,Ts)